{
  "name": "hewge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cdk": "cdk --app 'npx tsx infrastructure/app.ts'",
    "synth": "npm run cdk -- synth",
    "deploy:infra": "npm run cdk -- deploy --all --require-approval never",
    "deploy": "npm run build && node scripts/publish.mjs",
    "assets": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@aws-sdk/client-amplify": "^3.1000.0",
    "@aws-sdk/client-cloudformation": "^3.1000.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1150.0",
    "@aws-sdk/client-dynamodb": "^3.1000.0",
    "@aws-sdk/client-scheduler": "^3.1150.0",
    "@aws-sdk/client-secrets-manager": "^3.1000.0",
    "@aws-sdk/client-sesv2": "^3.1150.0",
    "@aws-sdk/credential-providers": "^3.1000.0",
    "@aws-sdk/lib-dynamodb": "^3.1000.0",
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "aws-cdk": "2.1145.0",
    "aws-cdk-lib": "2.273.0",
    "aws-jwt-verify": "^5.2.1",
    "constructs": "^10.4.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  }
}
